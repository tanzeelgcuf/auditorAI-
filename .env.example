# AI Auditor v1 — Environment Variables
# Copy this to .env for local dev

# Database
POSTGRES_PASSWORD=devpassword

# Auth
JWT_SECRET=dev-secret-change-in-production

# Storage (MinIO defaults for local dev)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ai-auditor
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Stripe (set for production)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=dev-secret
GLITCHTIP_SECRET_KEY=dev-secret

# LLM (required for agent-runtime)
ANTHROPIC_API_KEY=

# Internal MCP auth (agent-runtime -> API). Shared secret; agent-runtime sends
# it as X-Internal-Key to bypass user JWT on /mcp/* tools (doc 05 §3).
API_INTERNAL_KEY=

# Email (Resend — set for production)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
APP_BASE_URL=

# Domain (Traefik TLS — set for production)
DOMAIN=
LETSENCRYPT_EMAIL=